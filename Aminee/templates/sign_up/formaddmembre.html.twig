{% extends 'Login.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <section class="ftco-section mb-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 text-center">
                    <h2 class="heading-section">Inscription</h2>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-4">
                    <div>
                        {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_label(form.prenom, 'Prénom', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.nom, 'Nom', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.date_de_naissance, 'Date de naissance', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.date_de_naissance, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.date_de_naissance) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.pwd, 'Mot de passe', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                             {{ form_widget(form.pwd, {'attr': {'class': 'form-control', 'id': 'password'}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.Genre, 'Genre', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.Genre, {'attr': {'class': 'form-select'}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.Type, 'Type', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.Type, {'attr': {'class': 'form-select'}}) }}
                        </div>

                        <div class="mb-3">
                            <div class="input-group">
                                {{ form_widget(form.SignUp, {'attr': {'class': 'btn btn-primary w-100', 'id': 'signupButton'}}) }}
                            </div>
                        </div>
                        {{ form_end(form) }}

                        <div class="text-center mt-3">
                            <a href="{{ path('app_login') }}" class="text-white text-decoration-none">J'ai déjà un compte</a>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
