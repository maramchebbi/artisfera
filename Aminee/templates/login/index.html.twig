{% extends 'Login.html.twig' %}


{% block body %}
<section class="ftco-section mb-5">
		<div class="container">
			<div class="row justify-content-center">
                <div class="col-md-6 text-center">
                    <h2 class="heading-section login-title fw-bold text-uppercase text-primary">
                        <span class="border-bottom border-3 border-primary pb-1">Login</span>
                    </h2>
                </div>
            </div>

			<div class="row justify-content-center ">
				<div class="col-md-6 col-lg-4"> 
					<div class="login-wrap p-0">
		      	<form class="signin-form" method="POST" action="{{ path('app_login') }} ">
                    {% if error is defined and error is not empty %}
                        <div style="color: red; font-weight: bold;">
                            {{ error }}
                        </div>
                    {% endif %}
		      		<div class="form-group ">
                        <label for="email">Email :</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="E-mail" required>
        		    </div>
                    <div class="form-group">
                        <label for="password">Mot de passe :</label>
                        <div class="input-group">
                            <input type="password" id="password" name="password" class="form-control mb-5" placeholder="Password" required>
                           <button type="button" id="togglePassword" class=" mb-5"  >👁</button>

                        </div>

                    </div>
                    <button type="submit" class="btn btn-primary mb-2">Se connecter</button>
                    <div class="d-flex justify-content-center w-100">
                        <a href="{{ path('app_signup_newMembre') }}" class="text-white text-decoration-none">Créer un compte</a>
                        <span class="mx-2 text-white">|</span>
                        <a href="{{ path('app_forgot_password') }}" class="text-white text-decoration-none">Mot de passe oublié</a>
                    </div>

	          </form>
	         
				</div>
			</div>
		</div>
</section>
<style>
    #togglePassword {
        border-radius: 50px;
        font-size: 0.9rem;
        width: 50px;
        text-align: center;
        transition: all 0.3s;
    }

    #togglePassword:hover {
        background-color: #007bff;
        color: white;
    }


</style>

 <script>
    var passwordField = document.getElementById('password');
    var toggleButton = document.getElementById('togglePassword');
    toggleButton.addEventListener('mousedown', function () {
    passwordField.type = 'text';
    toggleButton.textContent = '🙈';  
});
    toggleButton.addEventListener('mouseup', function () {
    passwordField.type = 'password';
   toggleButton.textContent = '👁';  
    });
    toggleButton.addEventListener('mouseout', function () {
        passwordField.type = 'password';
        toggleButton.textContent = '👁';  
    });
    
</script> 

</div>

{% endblock %}

